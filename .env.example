# ============================================================
# Credit Policy & Circular Assistant — Environment Variables
# ============================================================
# Copy to .env and fill in your values.

# --- LLM Provider (pick one) ---
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...
LLM_PROVIDER=openai          # "openai" or "google"
LLM_MODEL=gpt-4o             # or "gemini-1.5-pro"

# --- Embedding Model ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# --- Reranker ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=credit_policy

# --- Paths ---
PDF_DIR=./data/raw_pdfs
PROCESSED_DIR=./data/processed

# --- Retrieval ---
DENSE_TOP_K=50
SPARSE_TOP_K=50
RRF_K=60
RERANK_TOP_K=5
ABSTENTION_THRESHOLD=0.35

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
